#!/bin/sh
# Free local check before pushing, so CI minutes are not spent on avoidable failures.
# Install once:  git config core.hooksPath .githooks
# Public rules by default (this repository is public); relax only for experiments: REPO_VISIBILITY=private git push
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
REPO_VISIBILITY="${REPO_VISIBILITY:-public}" exec python3 -m tools.repo_visibility_guard --history
