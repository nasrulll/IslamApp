{
  "name": "kitabku-fikihmu",
  "private": true,
  "version": "0.0.0",
  "description": "Fikihmu technical foundation, not production ready",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@fikihmu/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.2"
  }
}
